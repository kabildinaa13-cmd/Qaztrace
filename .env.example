VITE_API_BASE_URL=http://localhost:8787
AUTH_SECRET=replace_with_a_long_random_server_secret
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
REQUEST_BODY_LIMIT_BYTES=2097152
STORAGE_DRIVER=postgres
DATABASE_URL=postgres://chainsentinel:chainsentinel@localhost:5432/chainsentinel
# Безопасный режим по умолчанию: старые или чужие ключи блокчейн-провайдеров игнорируются.
ALLOW_CREDENTIALLED_PROVIDERS=false
# Бесплатные публичные метки бирж. Создайте СВОЙ ключ TRONSCAN; чужие ключи не используйте.
# После добавления собственного ключа установите ALLOW_CREDENTIALLED_PROVIDERS=true.
TRONSCAN_API_KEY=
TRONSCAN_API_BASE_URL=https://apilist.tronscanapi.com
PUBLIC_ATTRIBUTION_LOOKUP_LIMIT=20
# Защита бесплатного TRON API от HTTP 429: запросы идут по очереди, с повторами и кэшем.
TRON_PUBLIC_REQUEST_INTERVAL_MS=900
TRON_PUBLIC_MAX_RETRIES=4
TRON_PUBLIC_RETRY_BASE_MS=1500
TRON_PUBLIC_CACHE_TTL_MS=300000
TRON_TRACE_MAX_NODES=240
# Бесплатный локальный ИИ. Материалы расследования не отправляются во внешний облачный сервис.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=45000
PUBLIC_RPC_ETH_URL=https://ethereum-rpc.publicnode.com
PUBLIC_RPC_ARB_URL=https://arb1.arbitrum.io/rpc
PUBLIC_RPC_BASE_URL=https://mainnet.base.org
PUBLIC_RPC_BNB_URL=https://bsc-dataseed.binance.org
PUBLIC_RPC_OP_URL=https://mainnet.optimism.io
PUBLIC_RPC_POLYGON_URL=https://polygon-rpc.com
TELEGRAM_BOT_TOKEN=server_side_telegram_bot_token_for_npm_run_api
ALCHEMY_PRICES_HOST=api.g.alchemy.com
OFAC_SLS_BASE_URL=https://sanctionslistservice.ofac.treas.gov
OFAC_SLS_FILES=SDN_ENHANCED.XML,CONS_ENHANCED.XML
ETHERSCAN_REQUEST_DELAY_MS=450
ETHERSCAN_RATE_LIMIT_RETRY_MS=1500
ROUTESCAN_REQUEST_DELAY_MS=650
BLOCKSCOUT_ETH_URL=https://eth.blockscout.com
BLOCKSCOUT_ARB_URL=https://arbitrum.blockscout.com
BLOCKSCOUT_BASE_URL=https://base.blockscout.com
BLOCKSCOUT_OP_URL=https://explorer.optimism.io
BLOCKSCOUT_CELO_URL=https://celo.blockscout.com
BLOCKSCOUT_HEMI_URL=https://explorer.hemi.xyz
BLOCKSCOUT_LINEA_URL=https://explorer.linea.build
BLOCKSCOUT_MEGAETH_URL=https://megaeth.blockscout.com
BLOCKSCOUT_POLYGON_URL=https://polygon.blockscout.com
BLOCKSCOUT_SCROLL_URL=https://scroll.blockscout.com
BLOCKSCOUT_UNICHAIN_URL=https://unichain.blockscout.com
BLOCKSCOUT_ZKSYNC_URL=https://zksync.blockscout.com
BLOCKSCOUT_GNOSIS_URL=https://gnosis.blockscout.com
# BNB Chain works without a private key through Binplorer's public freekey.
BINPLORER_BNB_URL=https://api.binplorer.com
BINPLORER_API_KEY=
# Optional personal Etherscan key enables additional free-tier networks.
ETHERSCAN_API_KEY=
MEMPOOL_API_BASE=https://mempool.space/api
MEMPOOL_EXPLORER_BASE=https://mempool.space
BLOCKSTREAM_API_BASE=https://blockstream.info/api
BLOCKSTREAM_EXPLORER_BASE=https://blockstream.info
BLOCKCHAIN_API_BASE=https://blockchain.info
BLOCKCHAIN_EXPLORER_BASE=https://www.blockchain.com/explorer
# Personal Arkham Intel API key. Keep it only in the local .env file.
ARKHAM_API_KEY=
ARKHAM_HOST=api.arkm.com
ARKHAM_GRAPH_ENRICHMENT_LIMIT=24
RISK_CACHE_TTL_MS=900000
PRICE_CACHE_TTL_MS=300000
WATCHLIST_POLL_INTERVAL_MS=60000
